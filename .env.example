# 复制为 .env 后修改：cp .env.example .env
#
# 端口：同时决定「宿主机映射端口」和「容器内监听端口」。
# 宿主机的 3000 被别的应用占了，就把这里改成 8080，然后 docker compose up -d。
# 改完用 docker compose ps 能看到 0.0.0.0:8080->8080/tcp。
PORT=3000

# ---- 管理员账号 ----
# ADMIN_PASS 只在「数据库为空、首次启动」时用于创建管理员。
# 已经有 data/db.json 时它不会覆盖旧密码。
ADMIN_USER=admin
# 密码含 # $ 空格 等字符时，务必用单引号包起来，否则会被 .env 语法吃掉：
#   ADMIN_PASS='my#pass$2026'
#   ADMIN_PASS='a b c'
ADMIN_PASS='change-this-password'

# 忘记密码时：把下面这行取消注释并设成 1，重启一次即可用上面的 ADMIN_PASS 覆盖，
# 所有旧登录会话会失效。重置完记得改回 0 或删掉这一行。
# ADMIN_RESET_PASS=1

# 数据目录（仅本机 npm start 时生效；容器内固定为 /app/data）
DATA_DIR=./data
